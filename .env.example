DATA_PROVIDER=local

# MongoDB Atlas
# DATA_PROVIDER=mongodb
# MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/district_mapper?retryWrites=true&w=majority"

# Auth session signing
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Optional — used only by `npm run db:seed-admin` (stores hashed password in MongoDB)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_NAME=Your Name
